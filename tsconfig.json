{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    "vite-env.d.ts",
    ".react-router/types/**/*"
  ],
  "types": ["vite/client", "node"],
  "compilerOptions": {
    "typeRoots": ["node_modules/@types", "node_modules/vite"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"],
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
